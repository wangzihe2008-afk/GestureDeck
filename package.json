{
  "name": "gesturedeck",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "setup": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:connector": "node scripts/build-connector.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:connector",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-unknown",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
